# ==== Discord ====
# Discord Developer Portal -> 你的 Application -> Bot -> Reset Token 复制到这里
DISCORD_TOKEN=
# Application ID（开发者门户 General Information 页面）
CLIENT_ID=
# 测试服务器 ID（填了只在这个服务器注册命令，生效快；留空则全局注册，最长要等1小时）
GUILD_ID=

# ==== 网站 API ====
# true = 使用内置 mock（网站接口没好之前本地跑通全流程用）
# false = 调真实网站接口，配合下面两项
MOCK_API=true
# mock 模式下每个用户的初始测试额度
MOCK_START_BALANCE=10000
API_BASE_URL=https://your-website.example.com
API_KEY=please-change-me

# ==== 红包规则 ====
# 过期时间（分钟），过期后剩余额度退回发送者
EXPIRY_MINUTES=120
# 单个红包最多多少份
MAX_COUNT=100
# 单个红包总额度上限
MAX_TOTAL=1000000
# 额度显示名称（只影响卡片文案）
UNIT_NAME=额度
# 数据库文件位置
DB_PATH=./data/bot.db
